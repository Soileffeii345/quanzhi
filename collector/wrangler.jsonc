{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "quanzhi-coin-collector",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quanzhi-coin-index",
      "database_id": "15e92cdd-968a-423b-aaca-f85ecda78f53",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["0 2 * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
